{
  "name": "agy-agent-mcp",
  "version": "0.1.1",
  "description": "MCP server for subagent-style task delegation to the Antigravity (agy) CLI: headless runs, live stream transcripts, git-audited file scope. Works with OpenCode, Claude Code, and any MCP client.",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "agy-agent-mcp": "bin/mcp.mjs"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/a4amk/agy-agent-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a4amk/agy-agent-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "antigravity",
    "antigravity-cli",
    "agy",
    "subagent",
    "subagents",
    "delegation",
    "coding-agent",
    "cli-agent",
    "headless",
    "opencode",
    "claude-code",
    "gemini"
  ],
  "scripts": {
    "start": "node src/index.ts",
    "test": "node test/client6.ts",
    "lint": "biome check src test bin",
    "lint:fix": "biome check --write src test bin"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
