{
  "name": "agy-agent-mcp",
  "version": "0.2.1",
  "description": "Zero-dependency MCP server for subagent-style task delegation to the Antigravity (agy) CLI: headless runs, live stream transcripts, git-audited file scope. Works with OpenCode, Claude Code, and any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agy-agent-mcp": "bin/mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/a4amk/agy-agent-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a4amk/agy-agent-mcp.git"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "antigravity",
    "antigravity-cli",
    "agy",
    "subagent",
    "subagents",
    "delegation",
    "coding-agent",
    "cli-agent",
    "headless",
    "opencode",
    "claude-code",
    "gemini"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "test": "node test/client6.ts",
    "pretest": "npm run build",
    "lint": "biome check src test bin",
    "lint:fix": "biome check --write src test bin",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  }
}
